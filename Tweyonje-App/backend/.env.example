# ---------------------------------------------------------------- Core
DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
# When False, restrict cross-origin requests to CORS_ALLOWED_ORIGINS below.
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://10.0.2.2,http://192.168.1.178,http://localhost:8080

# ---------------------------------------------------------------- Database
# DB_ENGINE: empty -> local SQLite | postgres -> PostgreSQL | postgis ->
# PostGIS (needs GDAL installed on the host).
DB_ENGINE=
DB_NAME=tweyonje
DB_USER=tweyonje
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5433

# ---------------------------------------------------------------- Security / JWT
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=30

# Dev-only: echo the OTP code in the API response as `dev_code`. Keep false in
# any non-local environment.
OTP_DEBUG_ECHO=false

# Reconciliation: hours after which stale live-provider PENDING payments are
# marked FAILED by `run_reconciliation`.
RECONCILIATION_STALE_HOURS=8

# Throttling
THROTTLE_AUTH_LOGIN=10/min
THROTTLE_OTP_SEND=5/min
THROTTLE_OTP_VERIFY=10/min
THROTTLE_PASSWORD_RESET=5/min
THROTTLE_AI_CLASSIFY=10/min
THROTTLE_ANON=60/min

# ---------------------------------------------------------------- Realtime (WebSocket)
# Redis URL used by Django Channels layer and Celery broker/backend.
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------- Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Run tasks synchronously in development when no worker is available.
CELERY_TASK_ALWAYS_EAGER=true

# Beat schedule (seconds between runs) - set to 0 to disable a schedule.
CELERY_PROCESS_DUE_SCHEDULES_SECONDS=300
CELERY_CHECK_SLA_SECONDS=900
CELERY_RETRY_NOTIFICATIONS_SECONDS=600

# ---------------------------------------------------------------- Payments
# dev | mtn | airtel
PAYMENT_PROVIDER=dev
# Shared secret required to authenticate MTN MoMo callbacks. When unset the
# webhook is disabled. Send it as `Authorization: Bearer <token>` or `?token=`.
MTN_MOMO_CALLBACK_TOKEN=
MTN_MOMO_CALLBACK_URL=
AIRTEL_CALLBACK_URL=

# MTN MoMo Collections API (https://momodeveloper.mtn.com)
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_TARGET_ENV=sandbox

# Airtel Money API (https://developers.airtel.africa)
AIRTEL_BASE_URL=https://openapiuat.airtel.africa
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_CALLBACK_KEY=

# ---------------------------------------------------------------- Notifications
FCM_SERVER_KEY=
# Path to a Firebase service-account JSON (used by firebase-admin).
FCM_CREDENTIALS_PATH=

# dev | twilio | africastalk
SMS_PROVIDER=dev
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
AFRICASTALK_USERNAME=
AFRICASTALK_API_KEY=

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@tweyonje.ug

# ---------------------------------------------------------------- misc
CURRENCY=UGX
USSD_CODE=*268#

# Optional: path to a trained waste classifier (joblib). When empty, the AI
# classify endpoint uses the deterministic keyword fallback.
AI_MODEL_PATH=

# Optional error monitoring
SENTRY_DSN=
