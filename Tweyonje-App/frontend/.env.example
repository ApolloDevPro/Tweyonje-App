# Tweyonje Flutter app configuration.
#
# Flutter does not read .env at runtime; supply these at build/run time:
#
#   flutter run --dart-define-from-file=.env
#   flutter run --dart-define=API_URL=http://192.168.1.178:8000
#
# Copy to `.env` and edit. Never commit real keys.

# Backend REST API base URL (no trailing slash, no /api/v1 suffix).
# Local:  http://127.0.0.1:8000
# Railway: https://your-app-name.up.railway.app
API_URL=http://127.0.0.1:8000

# Backend WebSocket base URL (`ws://` locally, `wss://` in production).
# Local:  ws://127.0.0.1:8000/ws/
# Railway: wss://your-app-name.up.railway.app/ws/
WS_URL=ws://127.0.0.1:8000/ws/

# Google Maps API key — only needed if you switch the map widget to
# google_maps_flutter. Optional; the default map uses OpenStreetMap.
GOOGLE_MAPS_API_KEY=